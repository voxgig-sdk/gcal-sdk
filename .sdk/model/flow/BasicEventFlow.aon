# BasicEventFlow

main: kit: flow: BasicEventFlow:
{
  entity: "event",
  kind: "basic",
  name: "BasicEventFlow",
  step: [
    {
      input: {
        ref: "event_ref01"
      }

      match: {
        calendar_id: "calendar01"
      }

      op: "create"
    }

    {
      match: {
        calendar_id: "calendar01",
        event_id: "event01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "event_ref01"
          }
        }
      ]
    }

    {
      data: {
        calendar_id: "calendar01"
      }

      input: {
        ref: "event_ref01",
        srcdatavar: "event_ref01_data",
        suffix: "_up0",
        textfield: "accessRole"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-event_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "event_ref01",
        srcdatavar: "event_ref01_data",
        suffix: "_dt0"
      }

      match: {
        calendar_id: "calendar01",
        id: "event01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-event_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "event_ref01",
        suffix: "_rm0"
      }

      match: {
        calendar_id: "calendar01",
        id: "event01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        calendar_id: "calendar01",
        event_id: "event01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEventFlow"
}