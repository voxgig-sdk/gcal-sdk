# BasicSettingFlow

main: kit: flow: BasicSettingFlow:
{
  entity: "setting",
  kind: "basic",
  name: "BasicSettingFlow",
  step: [
    {
      input: {
        ref: "setting_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "setting_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "setting_ref01",
        srcdatavar: "setting_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "setting01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSettingFlow"
}