# BasicCalendarListFlow

main: kit: flow: BasicCalendarListFlow:
{
  entity: "calendar_list",
  kind: "basic",
  name: "BasicCalendarListFlow",
  step: [
    {
      input: {
        ref: "calendar_list_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "calendar_list_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "calendar_list_ref01",
        srcdatavar: "calendar_list_ref01_data",
        suffix: "_up0",
        textfield: "accessRole"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-calendar_list_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "calendar_list_ref01",
        srcdatavar: "calendar_list_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "calendar_list01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-calendar_list_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "calendar_list_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "calendar_list01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "calendar_list_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCalendarListFlow"
}